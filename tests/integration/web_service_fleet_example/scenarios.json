    {"name": "job_queue_backs_up",
     "steps": [
       {"guest": "mmwatchdog-dev", "wait_until_succeeds": "python3 step_commands/mmwatchdog_check_state.py job_queue/job_queue_health_command_succeeds --state ok --latest-run ok --message-or-output-matches '^0 jobs wait in the queue'", "within_seconds": 10},
       {"guest": "mmwatchdog-dev", "run": "redis-cli -p 6381 RPUSH jobs:waiting $(seq 500) > /dev/null"},
       {"wait_for_alerts": [
          {"node": "mmwatchdog-dev", "check_group": "job_queue", "check": "job_queue_health_command_succeeds", "type": "failed", "alert_severity": "warn"}],
        "within_seconds": 30},
       {"guest": "mmwatchdog-dev", "run": "redis-cli -p 6381 DEL jobs:waiting > /dev/null"},
       {"wait_for_alerts": [
          {"node": "mmwatchdog-dev", "check_group": "job_queue", "check": "job_queue_health_command_succeeds", "type": "recovered", "alert_severity": "warn"}],
        "within_seconds": 30}]},

